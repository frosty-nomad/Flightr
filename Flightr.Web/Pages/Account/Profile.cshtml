@page
@model Flightr.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Edit Profile</h1>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @Model.StatusMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model.ErrorMessages.Count > 0)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <h5 class="alert-heading">Update failed</h5>
                <ul class="mb-0">
                    @foreach (var error in Model.ErrorMessages)
                    {
                        <li>@error</li>
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="post" class="card card-body shadow-sm">
            <div class="mb-3">
                <label asp-for="Input.PilotName" class="form-label"></label>
                <input asp-for="Input.PilotName" class="form-control" />
                <span asp-validation-for="Input.PilotName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.LicenseNumber" class="form-label"></label>
                <input asp-for="Input.LicenseNumber" class="form-control" />
                <span asp-validation-for="Input.LicenseNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.LicenseExpirationDate" class="form-label"></label>
                <input asp-for="Input.LicenseExpirationDate" class="form-control" type="date" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.LicenseGoal" class="form-label"></label>
                <select asp-for="Input.LicenseGoal" class="form-select">
                    <option value="">Select a goal</option>
                    <option value="Sport">Sport</option>
                    <option value="Recreational">Recreational</option>
                    <option value="Private">Private</option>
                    <option value="Commercial">Commercial</option>
                </select>
                <span asp-validation-for="Input.LicenseGoal" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
