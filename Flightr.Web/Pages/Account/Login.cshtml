@page
@model Flightr.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1 class="h3 mb-3">Login</h1>

        @if (TempData["RegistrationStatusMessage"] is string statusMessage)
        {
            <div class="alert alert-success">@statusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.LoginErrorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @Model.LoginErrorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <form method="post" class="card card-body shadow-sm">
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="text-danger" asp-validation-summary="ModelOnly"></div>
            <button type="submit" class="btn btn-primary w-100">Sign in</button>
            <div class="text-center mt-3">
                <a asp-page="/Account/ForgotPassword" class="link-secondary">Forgot Password?</a>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(Model.AccountNotFoundMessage))
        {
            <div class="alert alert-info mt-3">
                <strong>Don't have an account?</strong>
                <p class="mb-0 mt-2">@Model.AccountNotFoundMessage<a asp-page="/Account/Register" class="alert-link">Create one now</a> to get started with Flightr.</p>
            </div>
        }
        else
        {
            <div class="mt-3 text-center">
                <a asp-page="/Account/Register">Create an account</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
