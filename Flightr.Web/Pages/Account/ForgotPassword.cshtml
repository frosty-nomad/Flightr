@page
@model Flightr.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password?";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1 class="h3 mb-3">Forgot Password?</h1>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-info">@Model.StatusMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ResetLink))
        {
            <div class="alert alert-success">
                <p class="mb-2">Use this link to reset your password:</p>
                <a href="@Model.ResetLink">Reset Password</a>
            </div>
        }

        <form method="post" class="card card-body shadow-sm">
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="text-danger" asp-validation-summary="ModelOnly"></div>

            <button type="submit" class="btn btn-primary w-100">Generate reset link</button>
            <div class="text-center mt-3">
                <a asp-page="/Account/Login" class="btn btn-link">Back to login</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}