@page
@model Flightr.Web.Pages.FlightLogs.IndexModel
@{
    ViewData["Title"] = "My Flight Logs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">My Flight Logs</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="javascript:void(0);" onclick="downloadFlightLog()">Download Flight Log</a>
        <a class="btn btn-primary" asp-page="/FlightLogs/Create">New log</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (Model.Logs.Count == 0)
{
    <div class="alert alert-info">No flight logs yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Aircraft</th>
                    <th>Route</th>
                    <th>PIC</th>
                    <th>SIC</th>
                    <th>Night</th>
                    <th>XC</th>
                    <th>Total</th>
                    <th>Instr</th>
                    <th>Landings</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td>@log.FlightDate.ToString("yyyy-MM-dd")</td>
                        <td>@log.AircraftType</td>
                        <td>@log.Route</td>
                        <td>@log.PicHours.ToString("0.00")</td>
                        <td>@log.SicHours.ToString("0.00")</td>
                        <td>@log.NightHours.ToString("0.00")</td>
                        <td>@log.CrossCountryHours.ToString("0.00")</td>
                        <td>@log.TotalHours.ToString("0.00")</td>
                        <td>@log.InstrumentHours.ToString("0.00")</td>
                        <td>@log.LandingsDay + @log.LandingsNight</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/FlightLogs/Edit" asp-route-id="@log.Id">Edit</a>
                            <button
                                type="button"
                                class="btn btn-sm btn-outline-danger js-delete-log"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteLogModal"
                                data-log-id="@log.Id"
                                data-log-summary="@log.FlightDate.ToString("yyyy-MM-dd") (@log.AircraftType)"
                                data-log-route="@log.Route"
                            >Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="modal fade" id="deleteLogModal" tabindex="-1" aria-labelledby="deleteLogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteLogModalLabel">Delete Flight Log</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Are you sure you want to delete this flight log?</p>
                <div class="alert alert-warning mb-0">
                    <strong id="deleteLogSummary"></strong>
                    <div id="deleteLogRoute" class="small mt-1"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" class="d-inline">
                    <input type="hidden" id="deleteLogId" name="id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function downloadFlightLog() {
            fetch("?handler=Download")
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Failed to download flight log");
                    }
                    return response.blob();
                })
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement("a");
                    a.href = url;
                        const now = new Date();
                        const dateStr = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
                        const timeStr = String(now.getHours()).padStart(2, '0') + '-' + String(now.getMinutes()).padStart(2, '0');
                        a.download = `flight-log-${dateStr}-${timeStr}.csv`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                })
                .catch(error => {
                    console.error("Download error:", error);
                    alert("Failed to download flight log. Please try again.");
                });
        }

        document.addEventListener("DOMContentLoaded", () => {
            const modal = document.getElementById("deleteLogModal");
            if (!modal) {
                return;
            }

            modal.addEventListener("show.bs.modal", event => {
                const button = event.relatedTarget;
                const logId = button?.getAttribute("data-log-id") ?? "";
                const summary = button?.getAttribute("data-log-summary") ?? "";
                const route = button?.getAttribute("data-log-route") ?? "";

                const idInput = document.getElementById("deleteLogId");
                const summaryElement = document.getElementById("deleteLogSummary");
                const routeElement = document.getElementById("deleteLogRoute");

                if (idInput) {
                    idInput.value = logId;
                }

                if (summaryElement) {
                    summaryElement.textContent = summary;
                }

                if (routeElement) {
                    routeElement.textContent = route ? `Route: ${route}` : "";
                }
            });
        });
    </script>
}
